# ─── APP ────────────────────────────────────────────────────────────────
APP_NAME=SpecForge
APP_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── DATABASE ───────────────────────────────────────────────────────────
# Leave EMPTY for local dev -> falls back to sqlite:///./specforge.db
# Production: Supabase connection string (needs the pgvector extension)
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ─── AI · GEMINI ────────────────────────────────────────────────────────
# ** THE ONLY VALUE YOU MUST FILL IN ** -> aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── RAG · EMBEDDINGS ───────────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
ENABLE_SEMANTIC_RAG=true
SEMANTIC_RAG_TOP_K=5
SEMANTIC_RAG_MIN_SCORE=0.50

# ─── EXTRACTION ─────────────────────────────────────────────────────────
EXTRACTION_MAX_CHARS=12000          # source text sent to the model per call
EXTRACTION_MAX_SOURCES=5            # sources read per product
VISION_ENABLED=true
VISION_MAX_PAGES=10                 # hard cap per document — cost control
VISION_DPI=200                      # pymupdf render resolution

# ─── VALIDATION & CONFIDENCE ────────────────────────────────────────────
REVIEW_CONFIDENCE_THRESHOLD=75      # below this -> human review queue
AUTO_APPROVE_THRESHOLD=85           # at or above -> bulk-approvable
CONFLICT_AUTO_RESOLVE_DELTA=25      # confidence gap that auto-picks a winner
NUMERIC_CONFLICT_TOLERANCE=0.01     # 1% — below this, values "agree"
VALIDATION_FLAG_PENALTY=15          # confidence lost per rule failure
AI_PLAUSIBILITY_ENABLED=true

# ─── INGESTION & STORAGE ────────────────────────────────────────────────
STORAGE_DIR=./storage/sources       # where uploaded PDFs/images are kept
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.pdf,.docx,.txt,.md,.png,.jpg,.jpeg,.webp

# ─── SOURCE FETCHING (secondary path — documents come first) ────────────
SOURCE_REQUEST_TIMEOUT=8
SOURCE_MAX_RESPONSE_BYTES=1048576
SOURCE_USER_AGENT=SpecForge Product Intelligence Bot/1.0
RESPECT_ROBOTS_TXT=true

# ─── JOBS · SCALE ───────────────────────────────────────────────────────
ENRICHMENT_BATCH_LIMIT=50           # products per job run
ENRICHMENT_MAX_CONCURRENCY=4
JOB_STALE_MINUTES=30                # older running jobs marked failed

# ─── SECURITY ───────────────────────────────────────────────────────────
# Leave EMPTY locally. Set in production -> POST/PATCH/DELETE need X-API-Key.
# GET stays open so judges can browse the prototype.
API_KEY=