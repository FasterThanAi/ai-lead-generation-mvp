# App
APP_NAME=AI Lead Generation MVP
APP_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
# Default SQLite configuration for local development
DATABASE_URL=sqlite:///./leadgen.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# AI
# Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional n8n webhook URL for workflow automation
N8N_WEBHOOK_URL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
ENABLE_SEMANTIC_RAG=true
SEMANTIC_RAG_TOP_K=5
SEMANTIC_RAG_MIN_SCORE=0.50

# Gmail
# Google OAuth credentials obtained from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Local Gmail redirect URI (typically http://localhost:8000/api/v1/auth/gmail/callback)
GMAIL_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
GMAIL_DAILY_LIMIT=20

# Enrichment
# Hunter API key from https://hunter.io/api_keys ('test-api-key' returns dummy Hunter data for testing)
HUNTER_API_KEY=test-api-key
HUNTER_REQUEST_TIMEOUT=8
HUNTER_BULK_MAX_LEADS=10
HUNTER_BULK_MAX_SECONDS=45
HUNTER_BULK_DELAY_SECONDS=0.25
# Apollo API key obtained from Apollo settings (https://app.apollo.io/#/settings/integrations/api)
APOLLO_API_KEY=

# Vapi
# Voice AI settings and API credentials from Vapi Dashboard (https://dashboard.vapi.ai/)
VAPI_ENABLED=false
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_DEFAULT_TEST_PHONE=
VAPI_BASE_URL=https://api.vapi.ai

# --- Security / auth -------------------------------------------------------
# Required in production: openssl rand -hex 32
SECRET_KEY=
# Optional separate key for encrypting stored OAuth tokens (defaults to SECRET_KEY)
TOKEN_ENCRYPTION_KEY=
AUTH_ENABLED=true
# First user to sign up becomes admin; after that only admins add members unless this is true
ALLOW_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Optional: create this admin automatically on an empty database
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional comma-separated Host header allow-list, e.g. api.example.com
TRUSTED_HOSTS=

# --- Platform --------------------------------------------------------------
LOG_LEVEL=INFO
# JSON logs default to on when APP_ENV=production
LOG_JSON=false
# Shared rate-limit counters across replicas (e.g. redis://localhost:6379/0)
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RUN_MIGRATIONS_ON_STARTUP=true
METRICS_ENABLED=true
# If set, /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
STALE_JOB_MINUTES=60

# --- Uploads / compliance --------------------------------------------------
MAX_UPLOAD_MB=10
CSV_MAX_ROWS=5000
# Public base URL of this API; enables unsubscribe links in sent emails
PUBLIC_API_URL=
UNSUBSCRIBE_LINKS_ENABLED=true
