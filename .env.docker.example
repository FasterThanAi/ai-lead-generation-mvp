# Copy to .env for `docker compose up`. Never commit the real file.
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
PUBLIC_WEB_URL=http://localhost:8080
WEB_PORT=8080
WEB_CONCURRENCY=2

# First admin (optional; otherwise the first person to open the app creates it)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Integrations (all optional)
GEMINI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/oauth/callback
GMAIL_SENDER_EMAIL=
HUNTER_API_KEY=
APOLLO_API_KEY=
N8N_WEBHOOK_URL=
VAPI_ENABLED=false
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
