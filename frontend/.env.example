# Base URL of the API.
# Leave empty for local dev: Vite proxies /api to VITE_DEV_API_TARGET.
# Docker/nginx also serve /api on the same origin. Set it only when the API is
# on another host, e.g. https://your-api.onrender.com/api for Vercel.
VITE_API_BASE_URL=
# Where the dev server forwards /api (default http://127.0.0.1:8000)
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_FRONTEND_PORT=5173
